#!/usr/bin/env node

/**
 * tools/scroll-benchmark
 * 
 * Benchmark tool for measuring scrolling performance via Chrome DevTools Protocol (CDP).
 * Works against both Anarc (via ANARC_REMOTE_DEBUGGING_PORT) and Chromium/Chrome.
 * 
 * Metrics:
 * - Frame interval distribution: Mean, p50 (median), p95, p99, Min, Max, StdDev
 * - Dropped frame count and percentage (intervals > 1.5 * nominal frame time)
 * - Process CPU utilization
 */

const http = require('http');
const { spawnSync } = require('child_process');

const PORT = parseInt(process.env.ANARC_REMOTE_DEBUGGING_PORT || process.env.CDP_PORT || '9222', 10);
const TARGET_URL = process.argv[2] || 'https://en.wikipedia.org/wiki/Linux';
const DURATION_MS = parseInt(process.env.BENCH_DURATION_MS || '5000', 10);
const SCROLL_STEP = parseInt(process.env.BENCH_SCROLL_STEP || '40', 10); // px per wheel tick

function getJson(url) {
  return new Promise((resolve, reject) => {
    http.get(url, (res) => {
      let data = '';
      res.on('data', chunk => data += chunk);
      res.on('end', () => {
        try {
          resolve(JSON.parse(data));
        } catch (e) {
          reject(e);
        }
      });
    }).on('error', reject);
  });
}

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

function getProcessCpu(pid) {
  try {
    const out = spawnSync('ps', ['-p', pid.toString(), '-o', '%cpu']).stdout.toString();
    const lines = out.trim().split('\n');
    if (lines.length > 1) {
      return parseFloat(lines[1].trim()) || 0.0;
    }
  } catch (_) {}
  return 0.0;
}

async function findOrOpenTarget(browserWsUrl) {
  const targets = await getJson(`http://127.0.0.1:${PORT}/json`);
  let page = targets.find(t => t.type === 'page' && t.webSocketDebuggerUrl);
  if (page) {
    return page;
  }

  // If no page target exists, create one via the browser websocket
  return new Promise((resolve, reject) => {
    const ws = new WebSocket(browserWsUrl);
    ws.onopen = () => {
      ws.send(JSON.stringify({
        id: 1,
        method: 'Target.createTarget',
        params: { url: TARGET_URL }
      }));
    };
    ws.onmessage = async (evt) => {
      const msg = JSON.parse(evt.data);
      if (msg.id === 1 && msg.result && msg.result.targetId) {
        ws.close();
        await sleep(1000);
        const updated = await getJson(`http://127.0.0.1:${PORT}/json`);
        const found = updated.find(t => t.id === msg.result.targetId || (t.type === 'page' && t.webSocketDebuggerUrl));
        if (found) resolve(found);
        else reject(new Error('Failed to locate newly created target'));
      }
    };
    ws.onerror = reject;
  });
}

class CdpClient {
  constructor(wsUrl) {
    this.wsUrl = wsUrl;
    this.ws = null;
    this.id = 1;
    this.callbacks = new Map();
  }

  async connect() {
    return new Promise((resolve, reject) => {
      this.ws = new WebSocket(this.wsUrl);
      this.ws.onopen = () => resolve();
      this.ws.onerror = (err) => reject(err);
      this.ws.onmessage = (evt) => {
        const msg = JSON.parse(evt.data);
        if (msg.id && this.callbacks.has(msg.id)) {
          const cb = this.callbacks.get(msg.id);
          this.callbacks.delete(msg.id);
          if (msg.error) cb.reject(new Error(msg.error.message));
          else cb.resolve(msg.result);
        }
      };
    });
  }

  send(method, params = {}) {
    return new Promise((resolve, reject) => {
      const id = this.id++;
      this.callbacks.set(id, { resolve, reject });
      this.ws.send(JSON.stringify({ id, method, params }));
    });
  }

  close() {
    if (this.ws) {
      this.ws.close();
    }
  }
}

function calculateStats(samples, nominalInterval) {
  if (samples.length === 0) return null;
  samples.sort((a, b) => a - b);
  const sum = samples.reduce((acc, v) => acc + v, 0);
  const mean = sum / samples.length;
  const p50 = samples[Math.floor(samples.length * 0.50)];
  const p95 = samples[Math.floor(samples.length * 0.95)];
  const p99 = samples[Math.floor(samples.length * 0.99)];
  const min = samples[0];
  const max = samples[samples.length - 1];

  const variance = samples.reduce((acc, v) => acc + Math.pow(v - mean, 2), 0) / samples.length;
  const stddev = Math.sqrt(variance);

  // Dropped frames: interval > 1.5 * nominal
  const dropThreshold = nominalInterval * 1.5;
  const dropped = samples.filter(v => v > dropThreshold).length;
  const droppedPct = (dropped / samples.length) * 100;

  return {
    count: samples.length,
    nominalInterval: parseFloat(nominalInterval.toFixed(2)),
    mean: parseFloat(mean.toFixed(2)),
    p50: parseFloat(p50.toFixed(2)),
    p95: parseFloat(p95.toFixed(2)),
    p99: parseFloat(p99.toFixed(2)),
    min: parseFloat(min.toFixed(2)),
    max: parseFloat(max.toFixed(2)),
    stddev: parseFloat(stddev.toFixed(2)),
    dropped,
    droppedPct: parseFloat(droppedPct.toFixed(2)),
  };
}

async function main() {
  console.log(`Connecting to CDP on http://127.0.0.1:${PORT}...`);
  let version;
  try {
    version = await getJson(`http://127.0.0.1:${PORT}/json/version`);
  } catch (e) {
    console.error(`Cannot connect to CDP on port ${PORT}: ${e.message}`);
    process.exit(1);
  }

  console.log(`Browser: ${version.Browser}`);
  const target = await findOrOpenTarget(version.webSocketDebuggerUrl);
  console.log(`Using target: "${target.title}" (${target.url})`);

  const client = new CdpClient(target.webSocketDebuggerUrl);
  await client.connect();

  await client.send('Page.enable');
  await client.send('Runtime.enable');

  // Navigate to target URL if not already there
  if (TARGET_URL && !target.url.includes(new URL(TARGET_URL).pathname)) {
    console.log(`Navigating to ${TARGET_URL}...`);
    await client.send('Page.navigate', { url: TARGET_URL });
    await sleep(2500); // allow initial page layout
  }

  // Detect display refresh rate in page
  const refreshInfo = await client.send('Runtime.evaluate', {
    expression: `
      new Promise(resolve => {
        let frames = [];
        let t0 = performance.now();
        function check(t) {
          frames.push(t);
          if (frames.length < 30) requestAnimationFrame(check);
          else {
            let intervals = [];
            for (let i = 1; i < frames.length; i++) intervals.push(frames[i] - frames[i-1]);
            intervals.sort((a,b)=>a-b);
            let median = intervals[Math.floor(intervals.length/2)];
            let hz = Math.round(1000 / median);
            resolve({ hz, median });
          }
        }
        requestAnimationFrame(check);
      })
    `,
    awaitPromise: true,
    returnByValue: true,
  });

  const nominalInterval = refreshInfo.result.value ? refreshInfo.result.value.median : 6.94;
  const displayHz = refreshInfo.result.value ? refreshInfo.result.value.hz : 144;
  console.log(`Display refresh rate detected: ~${displayHz} Hz (nominal interval: ${nominalInterval.toFixed(2)} ms)`);

  // Inject measurement harness into page
  await client.send('Runtime.evaluate', {
    expression: `
      window.__scrollBench = {
        intervals: [],
        lastTime: 0,
        running: false,
        start() {
          this.intervals = [];
          this.running = true;
          this.lastTime = performance.now();
          const tick = (now) => {
            if (!this.running) return;
            const delta = now - this.lastTime;
            this.lastTime = now;
            this.intervals.push(delta);
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        },
        stop() {
          this.running = false;
          return this.intervals;
        }
      };
      window.__scrollBench.start();
    `
  });

  console.log(`Benchmarking scroll for ${DURATION_MS} ms...`);

  // Track CPU samples
  const cpuSamples = [];
  const pgrep = spawnSync('pgrep', ['-f', version.Browser.includes('Chrome') && !version.Browser.includes('156.0.8078') ? 'chromium' : 'anarc']);
  const pids = pgrep.stdout.toString().trim().split('\n').filter(Boolean);
  const mainPid = pids.length > 0 ? parseInt(pids[0], 10) : null;

  const startTime = Date.now();
  let stepDirection = 1;
  let currentScrollY = 0;

  // Active scroll driving loop via CDP Input events
  const scrollInterval = setInterval(async () => {
    try {
      // Alternate direction when near boundaries
      currentScrollY += SCROLL_STEP * stepDirection;
      if (currentScrollY > 10000) stepDirection = -1;
      else if (currentScrollY < 100) stepDirection = 1;

      await client.send('Input.dispatchMouseEvent', {
        type: 'mouseWheel',
        x: 400,
        y: 400,
        deltaX: 0,
        deltaY: SCROLL_STEP * stepDirection,
      });
    } catch (_) {}
  }, 16);

  const cpuInterval = setInterval(() => {
    if (mainPid) {
      cpuSamples.push(getProcessCpu(mainPid));
    }
  }, 200);

  await sleep(DURATION_MS);
  clearInterval(scrollInterval);
  clearInterval(cpuInterval);

  // Stop measurement and fetch intervals
  const evalResult = await client.send('Runtime.evaluate', {
    expression: 'window.__scrollBench.stop()',
    returnByValue: true,
  });

  const intervals = evalResult.result.value || [];
  // Skip the first 2 intervals as warm-up
  const cleanIntervals = intervals.slice(2);

  const stats = calculateStats(cleanIntervals, nominalInterval);
  const avgCpu = cpuSamples.length > 0 ? cpuSamples.reduce((a, b) => a + b, 0) / cpuSamples.length : 0;

  console.log('\n--- SCROLL BENCHMARK RESULTS ---');
  console.log(`Samples collected:    ${stats.count}`);
  console.log(`Nominal interval:     ${stats.nominalInterval} ms (${displayHz} Hz)`);
  console.log(`Mean frame interval:  ${stats.mean} ms`);
  console.log(`p50 (median):         ${stats.p50} ms`);
  console.log(`p95:                  ${stats.p95} ms`);
  console.log(`p99:                  ${stats.p99} ms`);
  console.log(`Min / Max:            ${stats.min} ms / ${stats.max} ms`);
  console.log(`Std Dev (jitter):     ${stats.stddev} ms`);
  console.log(`Dropped frames:       ${stats.dropped} (${stats.droppedPct}%)`);
  if (mainPid) {
    console.log(`Avg Process CPU:      ${avgCpu.toFixed(1)}%`);
  }
  console.log('--------------------------------\n');

  // Print JSON for programmatic ingestion
  const report = {
    browser: version.Browser,
    url: TARGET_URL,
    displayHz,
    nominalInterval,
    stats,
    avgCpu: parseFloat(avgCpu.toFixed(1)),
  };
  console.log('REPORT_JSON:' + JSON.stringify(report));

  client.close();
}

main().catch(err => {
  console.error(err);
  process.exit(1);
});
